generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Club {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  clubBalance ClubBalance?
  tournaments  Tournament[]

  @@map("club")
} 

model Rate {
  id          String       @id @default(uuid())
  name        String
  players     Int // 7, 9, or 11
  refRate     Float
  aRate       Float
  tournaments Tournament[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  @@map("rate")
}

model Tournament {
  id         String   @id @default(uuid())
  name       String
  year       Int
  startDate  DateTime
  endDate    DateTime
  totalGames Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  // Game Configuration (Batching)
  countA    Int @default(0)
  durationA Int @default(0)
  countB    Int @default(0)
  durationB Int @default(0)
  countC    Int @default(0)
  durationC Int @default(0)

  // Financials
  totalCost Float @default(0) // Total Cost for this Tournament

  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  rateId String
  rate   Rate   @relation(fields: [rateId], references: [id])

  assignments RefereeAssignment[]

  @@map("tournament")
}

model Referee {
  id          String              @id @default(uuid())
  name        String
  totalCost   Float               @default(0)
  // Whether the referee has been paid for their accumulated cost
  paid        Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt
  assignments RefereeAssignment[]

  @@map("referee")
}

model RefereeAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Allocation
  countA Int @default(0)
  countB Int @default(0)
  countC Int @default(0)

  // Games as aRef
  countARef Int @default(0)
  countBRef Int @default(0)
  countCRef Int @default(0)

  // Cost
  totalCost Float @default(0)

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  refereeId String
  referee   Referee @relation(fields: [refereeId], references: [id], onDelete: Cascade)

  @@map("referee_assignment")
}

// Tracks what Municipality pays to the Club

model ClubFunding {
  id String @id @default(cuid())

  year   Int
  amount Float @default(300.00)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  clubBalances ClubBalance[]

  @@map("club_funding")
}

// Tracks the Net Balance (Calculated Cost vs Received Funding)

model ClubBalance {
  id String @id @default(cuid())

  // The total amount the club owes to referees (Sum of tournament costs)
  totalCost Float @default(0)

  clubId String @unique
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  // The total amount received from Municipality (Sum of funding)
  clubFundingId String
  clubFunding   ClubFunding @relation(fields: [clubFundingId], references: [id])

  // The Net Balance (Funding - Cost)
  netBalance Float

  // Whether the club has settled its debt (netBalance < 0)
  paid Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("club_balance")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}
